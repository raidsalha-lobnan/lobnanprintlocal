# Isolated demonstration frontend; never publish real accounting data with this legacy auth.
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
ENV VITE_SYNC_BACKEND=local-postgres
ENV VITE_SYNC_GATEWAY_MODE=true
RUN npm run build

FROM nginx:1.27-alpine
COPY cloud/nginx-preview.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html
ENV NGINX_ENVSUBST_FILTER=SYNC_DEVICE_TOKEN
EXPOSE 8080
