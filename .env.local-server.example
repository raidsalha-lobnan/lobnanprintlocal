# Copy this to .env.local-server and replace all placeholders. Never commit the real file.
POSTGRES_PASSWORD=GENERATE_A_STRONG_RANDOM_PASSWORD
SYNC_DEVICE_TOKEN=GENERATE_A_DIFFERENT_RANDOM_TOKEN_MINIMUM_32_CHARACTERS
SYNC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,null
# CLOUDFLARE_TUNNEL_TOKEN=GET_FROM_CLOUDFLARE_DASHBOARD

# Server-side Google Drive authorization — all secrets are PRIVATE to the main server.
# Create an OAuth WEB application in Google Cloud, activate Google Drive API,
# and register the exact redirect URL below under Authorized redirect URIs.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://lobnan-api.shares.zrok.io/api/v1/drive/oauth/callback
#
# Verified transactional email provider for sending the one-time consent link.
# RESEND_API_KEY=
# GOOGLE_DRIVE_LINK_FROM=Drive Authorization <drive@your-verified-domain.example>
#
# Two separate 32-byte random keys, base64 encoded. NEVER rotate without
# decrypting and migrating existing tokens/backups. Save recovery copies OFF PC.
# GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# GOOGLE_BACKUP_ENCRYPTION_KEY=
#
# Once the owner consents, the PostgreSQL server starts a verified encrypted
# cloud backup worker hourly (the existing Windows local backup task is untouched).
# Set to 0 to disable only this supplementary cloud backup worker.
# LOBNAN_ENABLE_SERVER_BACKUPS=1
# LOBNAN_BACKUP_INTERVAL_MINUTES=60
# LOBNAN_BACKUP_RETENTION_DAYS=30
# LOBNAN_BACKUP_DIR=D:\\LobnanData\\backups\\drive-export
# PG_DUMP_PATH=D:\\LobnanData\\pgsql-17\\pgsql\\bin\\pg_dump.exe
